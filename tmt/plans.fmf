summary: run virt-firmware-ts tmt tests
provision:
  how: virtual
  hardware:
    memory: '>= 4 GB'
    cpu:
      processors: ">= 2"
    virtualization:
      is-supported: true
prepare:
  - name: enable fips mode
    when: fips == yes
    how: feature
    fips: enabled
  - name: kvm support check
    how: shell
    when: kvm == yes
    script:
      - ls -l /dev/kvm
  - name: sev-snp support check (incomplete)
    how: shell
    when: snp == yes
    script:
      - ls -l /dev/sev
  - name: install packages for centos/rhel
    when: distro == rhel or distro == centos
    how: install
    package:
      - qemu-kvm-core
  - name: install packages for fedora
    when: distro == fedora
    how: install
    package:
      - qemu-system-x86-core
  - name: install virt-firmware-rs
    how: install
    package:
      - virt-firmware-rs
discover:
  how: fmf
execute:
  how: tmt
