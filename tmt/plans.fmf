summary: run virt-firmware-ts tmt tests
provision:
  hardware:
    boot:
      method: uefi
prepare:
  - name: kvm support check
    how: shell
    script:
      - ls -l /dev/kvm
  - name: install virt-firmware-rs
    how: install
    package:
      - virt-firmware-rs
discover:
  how: fmf
execute:
  how: tmt
