# -*- Makefile -*-

run-uefi-hello:
	qemu-efi-$(ARCH) -nographic -net none \
		-kernel target/$(ARCH)-unknown-uefi/debug/hello.efi

run-uefi-fwcfg:
	qemu-efi-$(ARCH) -nographic -net none \
		-kernel target/$(ARCH)-unknown-uefi/debug/fwcfg.efi

run-uefi-pciscan:
	qemu-efi-$(ARCH) -nographic -net none \
		-kernel target/$(ARCH)-unknown-uefi/debug/pciscan.efi

run-uefi-hoblist:
	qemu-efi-$(ARCH) -nographic -net none \
		-kernel target/$(ARCH)-unknown-uefi/debug/hoblist.efi

run-uefi-fdt:
	qemu-efi-$(ARCH) -nographic -net none \
		-kernel target/$(ARCH)-unknown-uefi/debug/hoblist.efi -append fdt

run-uefi-log:
	qemu-efi-$(ARCH) -nographic -net none \
		-kernel target/$(ARCH)-unknown-uefi/debug/debuglog.efi

run-uefi-msr:
	qemu-efi-$(ARCH) -nographic -net none \
		-kernel target/$(ARCH)-unknown-uefi/debug/msr.efi

run-uefi-netboot-coreos:
	qemu-efi-$(ARCH) -m 4G \
		-fw_cfg name=etc/edk2/https/cacerts,file=/etc/pki/ca-trust/extracted/edk2/cacerts.bin \
		-kernel target/$(ARCH)-unknown-uefi/debug/netboot.efi -append coreos

run-uefi-netboot-xyz:
	qemu-efi-$(ARCH) -m 4G \
		-fw_cfg name=etc/edk2/https/cacerts,file=/etc/pki/ca-trust/extracted/edk2/cacerts.bin \
		-kernel target/$(ARCH)-unknown-uefi/debug/netboot.efi -append xyz
