# -*- Makefile -*-

run-uefi-hello:
	qemu-efi-$(HOST_ARCH) -nographic -net none \
		-kernel target/$(HOST_ARCH)-unknown-uefi/debug/hello.efi

run-uefi-fwcfg:
	qemu-efi-$(HOST_ARCH) -nographic -net none \
		-kernel target/$(HOST_ARCH)-unknown-uefi/debug/fwcfg.efi

run-uefi-pciscan:
	qemu-efi-$(HOST_ARCH) -nographic -net none \
		\
		-device pcie-root-port,id=port0,addr=8.0,chassis=0,multifunction=on \
		-device pcie-root-port,id=port1,addr=8.1,chassis=1 \
		-device pcie-root-port,id=port2,addr=8.2,chassis=2 \
		-device pcie-root-port,id=port3,addr=8.3,chassis=3 \
		\
		-device pcie-root-port,id=port4,addr=8.4,chassis=4,io-reserve=1k \
		-device pcie-root-port,id=port5,addr=8.5,chassis=5,mem-reserve=4M \
		-device pcie-root-port,id=port6,addr=8.6,chassis=6,pref32-reserve=32M \
		-device pcie-root-port,id=port7,addr=8.7,chassis=7,pref64-reserve=256M \
		\
		-device pcie-pci-bridge,bus=port0,id=pci0 \
		-device virtio-scsi-pci,bus=port2 \
		-device qemu-xhci,bus=port3 \
		\
		-device pci-serial,bus=pci0 \
		\
		-kernel target/$(HOST_ARCH)-unknown-uefi/debug/pciscan.efi

run-uefi-hoblist:
	qemu-efi-$(HOST_ARCH) -nographic -net none \
		-kernel target/$(HOST_ARCH)-unknown-uefi/debug/hoblist.efi

run-uefi-fdt:
	qemu-efi-$(HOST_ARCH) -nographic -net none \
		-kernel target/$(HOST_ARCH)-unknown-uefi/debug/hoblist.efi -append fdt

run-uefi-log:
	qemu-efi-$(HOST_ARCH) -nographic -net none \
		-kernel target/$(HOST_ARCH)-unknown-uefi/debug/debuglog.efi

run-uefi-msr:
	qemu-efi-$(HOST_ARCH) -nographic -net none \
		-kernel target/$(HOST_ARCH)-unknown-uefi/debug/msr.efi

run-uefi-netboot-coreos:
	qemu-efi-$(HOST_ARCH) -m 4G \
		-fw_cfg name=etc/edk2/https/cacerts,file=/etc/pki/ca-trust/extracted/edk2/cacerts.bin \
		-kernel target/$(HOST_ARCH)-unknown-uefi/debug/netboot.efi -append coreos

run-uefi-netboot-xyz:
	qemu-efi-$(HOST_ARCH) -m 4G \
		-fw_cfg name=etc/edk2/https/cacerts,file=/etc/pki/ca-trust/extracted/edk2/cacerts.bin \
		-kernel target/$(HOST_ARCH)-unknown-uefi/debug/netboot.efi -append xyz

run-uefi-vmfwupdate-poweroff:
	qemu-efi-x86_64 -nographic -net none \
		-igvm /usr/share/edk2/ovmf/OVMF.igvm \
		-kernel target/x86_64-unknown-uefi/debug/vmfwupdate.efi \
		-append "poweroff" \
		-device vm-launch-update

run-uefi-vmfwupdate-reset:
	qemu-efi-x86_64 -nographic -net none \
		-igvm /usr/share/edk2/ovmf/OVMF.igvm \
		-kernel target/x86_64-unknown-uefi/debug/vmfwupdate.efi \
		-append "reset" \
		-device vm-launch-update
