# -*- Makefile -*-

HOST_KERNEL := /boot/vmlinuz-$(shell uname -r)
QEMU_DEVEL := /home/kraxel/projects/qemu/build/default/qemu-system-x86_64

run-hello-bios32:
	qemu-system-x86_64 -nographic -net none \
		-bios bios-32/hello.bin

run-hello:
	qemu-system-x86_64 -nographic -net none \
		-bios target/x86_64-unknown-none/debug/hello.bin

run-qemuinit:
	qemu-system-x86_64 -nographic -net none -M q35 \
		-bios target/x86_64-unknown-none/debug/qemuinit.bin \
		\
		-device pcie-root-port,id=port0,addr=8.0,chassis=0,multifunction=on \
		-device pcie-root-port,id=port1,addr=8.1,chassis=1 \
		-device pcie-root-port,id=port2,addr=8.2,chassis=2 \
		-device pcie-root-port,id=port3,addr=8.3,chassis=3 \
		\
		-device pcie-pci-bridge,bus=port0,id=pci0 \
		-device virtio-scsi-pci,bus=port2 \
		-device qemu-xhci,bus=port3 \
		\
		-device pci-serial,bus=pci0

run-mefisto:
	qemu-system-x86_64 -nographic -net none \
		-enable-kvm -no-reboot -M q35 -m 4G -cpu host \
		-bios target/x86_64-unknown-none/debug/mefisto.bin \
		\
		-device pcie-root-port,id=port0,addr=8.0,chassis=0,multifunction=on \
		-device pcie-root-port,id=port1,addr=8.1,chassis=1 \
		-device pcie-root-port,id=port2,addr=8.2,chassis=2 \
		-device pcie-root-port,id=port3,addr=8.3,chassis=3 \
		\
		-device virtio-scsi-pci,bus=port2 \
		-device qemu-xhci,bus=port3 \
		\
		-kernel $(HOST_KERNEL) \
		-append "console=ttyS0 panic=1 loglevel=7"

run-igvmtest:
	$(QEMU_DEVEL) -nographic -net none \
		-machine q35,igvm-cfg=igvm0 -m 4G -enable-kvm -cpu host \
		-object igvm-cfg,id=igvm0,file=target/x86_64-unknown-none/debug/igvmtest.igvm
