# -*- Makefile -*-

run-bios32-hello:
	qemu-system-x86_64 -nographic -net none \
		-bios bios-32/hello.bin

run-bios64-mini:
	qemu-system-x86_64 -nographic -net none \
		-bios target/x86_64-unknown-none/debug/mini.bin

run-bios64-hello:
	qemu-system-x86_64 -nographic -net none \
		-bios target/x86_64-unknown-none/debug/hello.bin
